{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://client-search-framework/schema/facet-shard.schema.json",
  "title": "Facet shard",
  "description": "One facets/<field>.<hash>.json file. See docs/06-faceted-search.md.",
  "type": "object",
  "additionalProperties": false,
  "required": ["type", "values"],
  "properties": {
    "type": { "type": "string", "enum": ["terms", "range", "hierarchy"] },
    "separator": {
      "type": "string",
      "description": "Path separator for type: hierarchy, e.g. '>'"
    },
    "values": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["count", "docs"],
        "properties": {
          "count": { "type": "integer", "minimum": 0 },
          "docs": {
            "type": "array",
            "items": { "type": "integer", "minimum": 0 }
          }
        }
      }
    },
    "sorted": {
      "description": "Only present for type: range -- every (value, doc) pair sorted ascending by value, so an arbitrary min/max filter can be resolved without precomputed bucket boundaries (docs/06-faceted-search.md#facet-index-structure). 'values' is always present but empty ({}) for a range shard in the current implementation -- precomputed buckets are a documented future optimization, not required for correctness.",
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["value", "doc"],
        "properties": {
          "value": { "type": "number" },
          "doc": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
