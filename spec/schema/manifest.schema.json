{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ktjn/searchable/main/spec/schema/manifest.schema.json",
  "title": "Manifest",
  "description": "Entry point of a searchable index. See docs/concepts/index-format.md#manifest.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "buildId",
    "format",
    "languages",
    "defaultLanguage",
    "fields",
    "docCount",
    "avgFieldLength",
    "shards"
  ],
  "properties": {
    "version": { "type": "integer", "minimum": 1 },
    "buildId": { "type": "string" },
    "format": { "type": "string", "enum": ["json", "binary"] },
    "languages": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "defaultLanguage": { "type": "string" },
    "fields": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["stored"],
        "properties": {
          "boost": { "type": "number", "exclusiveMinimum": 0 },
          "stored": { "type": "boolean" },
          "indexed": { "type": "boolean" },
          "facet": { "type": "boolean" }
        }
      }
    },
    "facetFields": {
      "type": "array",
      "items": { "type": "string" }
    },
    "docCount": {
      "description": "Doc count per language — see docs/concepts/index-format.md#manifest.",
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "integer", "minimum": 0 }
    },
    "avgFieldLength": {
      "description": "Average field length per language, then per field.",
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": { "type": "number", "minimum": 0 }
      }
    },
    "shards": {
      "type": "object",
      "additionalProperties": false,
      "required": ["terms", "docs"],
      "properties": {
        "terms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["lang", "prefix", "file", "termCount"],
            "properties": {
              "lang": { "type": "string" },
              "prefix": { "type": "string" },
              "file": { "type": "string" },
              "termCount": { "type": "integer", "minimum": 0 },
              "format": { "enum": ["json", "binary"] }
            }
          }
        },
        "facets": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["field", "file"],
            "properties": {
              "field": { "type": "string" },
              "file": { "type": "string" }
            }
          }
        },
        "docs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["shard", "file", "idRange"],
            "properties": {
              "shard": { "type": "integer", "minimum": 0 },
              "file": { "type": "string" },
              "idRange": {
                "type": "array",
                "items": { "type": "integer", "minimum": 0 },
                "minItems": 2,
                "maxItems": 2
              },
              "format": { "enum": ["json", "binary"] }
            }
          }
        }
      }
    },
    "synonyms": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "string" }
    },
    "pins": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": { "type": "string" }
    },
    "fuzzy": {
      "description": "lang -> fuzzy-shard descriptor, only present for languages with a built deletion dictionary. See fuzzy-shard.schema.json.",
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["file"],
        "properties": {
          "file": { "type": "string" },
          "format": { "enum": ["json", "binary"] }
        }
      }
    },
    "vectors": {
      "description": "Vector/hybrid search (docs/guides/vector-search.md), only present for a corpus built with a vectors option. See vector-shard.schema.json for the shard files themselves.",
      "type": "object",
      "additionalProperties": false,
      "required": ["dims", "quantization", "embeddingProvider", "shards"],
      "properties": {
        "dims": { "type": "integer", "minimum": 1 },
        "quantization": { "type": "string", "enum": ["float32", "int8"] },
        "embeddingProvider": {
          "type": "object",
          "oneOf": [
            {
              "additionalProperties": false,
              "required": ["type", "model"],
              "properties": {
                "type": { "const": "local-model" },
                "model": { "type": "string" }
              }
            },
            {
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "const": "remote-api" } }
            },
            {
              "additionalProperties": false,
              "required": ["type"],
              "properties": { "type": { "const": "custom" } }
            }
          ]
        },
        "shards": {
          "description": "lang -> vector-shard file.",
          "type": "object",
          "propertyNames": { "type": "string" },
          "additionalProperties": { "type": "string" }
        }
      }
    }
  }
}
