{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/ktjn/searchable/main/spec/schema/synonym-shard.schema.json",
  "title": "Synonym shard",
  "description": "One synonyms/<lang>.<hash>.json file. See docs/guides/synonyms.md.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "equivalences": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 2
      }
    },
    "directional": {
      "type": "object",
      "propertyNames": { "type": "string" },
      "additionalProperties": {
        "type": "array",
        "items": { "type": "string" }
      }
    },
    "multiWord": {
      "type": "array",
      "items": {
        "type": "array",
        "items": { "type": "string" },
        "minItems": 2
      }
    }
  }
}
