{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://client-search-framework/schema/doc-store-shard.schema.json",
  "title": "Doc store shard",
  "description": "One docs/<shard>.<hash>.json file: render-time data for a contiguous doc-id range. Only manifest fields marked stored:true appear here. See docs/02-index-format.md#doc-store-shard.",
  "type": "object",
  "propertyNames": {
    "description": "Doc id as a string key",
    "pattern": "^[0-9]+$"
  },
  "additionalProperties": {
    "type": "object",
    "additionalProperties": false,
    "required": ["url", "fields"],
    "properties": {
      "url": { "type": "string" },
      "boost": { "type": "number", "exclusiveMinimum": 0 },
      "fields": {
        "type": "object",
        "propertyNames": { "type": "string" },
        "additionalProperties": {
          "anyOf": [
            { "type": "string" },
            { "type": "array", "items": { "type": "string" } }
          ]
        }
      }
    }
  }
}
