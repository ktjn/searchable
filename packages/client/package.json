{
  "name": "@csf/client",
  "version": "0.0.0",
  "description": "Browser runtime: fetch a manifest and shards over plain HTTP, evaluate a query, return ranked hits.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./worker": "./dist/worker.js",
    "./sw": "./dist/sw.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json && tsc --noEmit -p tsconfig.e2e-browser.json",
    "check:bundle-size": "node scripts/check-bundle-size.mjs"
  },
  "dependencies": {
    "@csf/analysis": "workspace:*",
    "@csf/format": "workspace:*"
  },
  "devDependencies": {
    "@csf/fixtures": "workspace:*",
    "@csf/indexer": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "@types/node": "^22.10.5",
    "typescript": "^5.7.3",
    "vite": "^6.0.11",
    "vitest": "^2.1.9"
  },
  "peerDependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "peerDependenciesMeta": {
    "@huggingface/transformers": {
      "optional": true
    }
  }
}
