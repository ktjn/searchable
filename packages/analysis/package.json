{
  "name": "@ktjn/searchable-analysis",
  "version": "1.1.1",
  "description": "Tokenization/analysis pipeline for the TypeScript search client (query-time analysis). The Python port (searchable-analysis) is shared with the Python-only indexer, so index-time and query-time analysis can never drift apart.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktjn/searchable.git",
    "directory": "packages/analysis"
  },
  "homepage": "https://github.com/ktjn/searchable#readme",
  "bugs": "https://github.com/ktjn/searchable/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
