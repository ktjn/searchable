{
  "name": "@ktjn/searchable-format",
  "version": "1.4.1",
  "description": "TypeScript types for the manifest/shard JSON format (docs/concepts/index-format.md, spec/schema/*.schema.json), shared by the indexer and the client so both sides can't silently drift on the format's shape.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktjn/searchable.git",
    "directory": "packages/format"
  },
  "homepage": "https://github.com/ktjn/searchable#readme",
  "bugs": "https://github.com/ktjn/searchable/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "typescript": "catalog:"
  }
}
