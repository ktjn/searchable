{
  "name": "@ktjn/searchable-indexer",
  "version": "1.0.0",
  "description": "Reference indexer: rendered HTML in, manifest + shards out.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktjn/searchable.git",
    "directory": "packages/indexer"
  },
  "homepage": "https://github.com/ktjn/searchable#readme",
  "bugs": "https://github.com/ktjn/searchable/issues",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "searchable-indexer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/json-tier-scaling.mjs"
  },
  "dependencies": {
    "@ktjn/searchable-analysis": "workspace:*",
    "@ktjn/searchable-format": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "node-html-parser": "^9.0.0"
  },
  "devDependencies": {
    "@ktjn/searchable-fixtures": "workspace:*",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
