{
  "name": "@csf/indexer",
  "version": "1.0.0",
  "description": "Reference indexer: rendered HTML in, manifest + shards out.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ktjn/client-search-framework.git",
    "directory": "packages/indexer"
  },
  "homepage": "https://github.com/ktjn/client-search-framework#readme",
  "bugs": "https://github.com/ktjn/client-search-framework/issues",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js"
  },
  "bin": {
    "csf-indexer": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "vite build && tsc --emitDeclarationOnly",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "bench": "node bench/json-tier-scaling.mjs",
    "bench:binary": "node bench/binary-vs-json-postings.mjs",
    "bench:binary-lazy": "node bench/binary-lazy-decode.mjs"
  },
  "dependencies": {
    "@csf/analysis": "workspace:*",
    "@csf/format": "workspace:*",
    "@huggingface/transformers": "^4.2.0",
    "node-html-parser": "^9.0.0"
  },
  "devDependencies": {
    "@csf/fixtures": "workspace:*",
    "@types/node": "^26.1.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
