{
  "name": "client-search-framework",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "pretest": "pnpm build",
    "test": "vitest run",
    "pretest:browser": "pnpm build && pnpm --filter showcase build",
    "test:browser": "playwright test",
    "pretypecheck": "pnpm build",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck && pnpm --filter showcase run typecheck",
    "presize": "pnpm build",
    "size": "pnpm --filter @csf/client run check:bundle-size",
    "prebench": "pnpm build",
    "bench": "pnpm --filter @csf/indexer run bench",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@playwright/test": "^1.49.1",
    "@vitest/coverage-v8": "^4.1.10",
    "typescript": "^7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  }
}
