{
  "name": "searchable",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.20.0",
  "scripts": {
    "build": "pnpm -r --filter=./packages/* build",
    "docs:build": "pnpm build && pnpm --filter showcase build",
    "docs:check": "pnpm docs:build && pnpm --filter showcase validate && pnpm exec vitest run --config showcase/vitest.config.ts && pnpm test:browser",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "pnpm -r --filter=./packages/* run typecheck && pnpm --filter showcase run typecheck",
    "size": "pnpm --filter @ktjn/searchable-client run check:bundle-size",
    "relevance": "pnpm build && pnpm --filter @ktjn/searchable-relevance evaluate",
    "relevance:refresh": "pnpm build && pnpm --filter @ktjn/searchable-relevance refresh",
    "lint": "biome check .",
    "format": "biome format --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@playwright/test": "catalog:",
    "@types/node": "^26.1.2",
    "typescript": "catalog:",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
