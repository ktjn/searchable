{
  "name": "searchable",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "build": "pnpm --filter @ktjn/searchable build && pnpm --filter @ktjn/searchable-fixtures build",
    "docs:build": "pnpm build && pnpm --filter showcase build",
    "docs:check": "pnpm docs:build && pnpm --filter showcase validate && pnpm exec vitest run --config showcase/vitest.config.ts && pnpm test:browser",
    "test": "vitest run",
    "test:browser": "playwright test",
    "typecheck": "pnpm --filter @ktjn/searchable run typecheck && pnpm --filter showcase run typecheck",
    "size": "pnpm --filter @ktjn/searchable run check:bundle-size",
    "relevance": "pnpm build && pnpm --filter @ktjn/searchable-relevance evaluate",
    "relevance:refresh": "pnpm build && pnpm --filter @ktjn/searchable-relevance refresh",
    "lint": "biome check .",
    "format": "biome format --write .",
    "gate": "bash scripts/gate.sh",
    "prepare": "node scripts/install-hooks.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "@playwright/test": "catalog:",
    "@types/node": "^26.6.5",
    "typescript": "catalog:",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
